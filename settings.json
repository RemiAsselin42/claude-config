{
  "permissions": {
    "allow": [
      "Bash(xargs ls:*)",
      "Bash(xargs grep:*)",
      "Bash(npx vitest:*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push origin *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git stash *)",
      "Bash(git merge *)",
      "Bash(git init *)",
      "Bash(git clone *)",
      "Bash(git rm *)",
      "Bash(git mv *)",
      "Bash(git reset HEAD *)",
      "Bash(git reset --soft *)",

      "Bash(mkdir *)",
      "Bash(mkdir -p *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(cp -r *)",
      "Bash(mv *)",
      "Bash(chmod *)",

      "Bash(npm install)",
      "Bash(npm install *)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test)",
      "Bash(npm run dev)",
      "Bash(npm ci)",
      "Bash(npm validate)",

      "Bash(graphify *)",
      "Bash(mempalace *)",
      "Bash(rtk gain*)",
      "Bash(rtk discover*)",
      "Bash(rtk git *)",
      "Bash(bash *style-toggle*)",
      "Bash(bash *vibe-toggle*)",

      "Bash(gh auth status)",
      "Bash(gh repo create *)",
      "Bash(gh pr create *)",
      "Bash(gh issue create *)"
    ],
    "deny": [
      "Bash(rtk proxy *)",
      "Bash(git push*--force*)",
      "Bash(git push* -f*)",
      "Bash(rtk git push*--force*)",
      "Bash(rtk git push* -f*)",
      "Bash(gh pr merge*)",
      "Bash(rtk gh pr merge*)",
      "Bash(git rebase*)",
      "Bash(rtk git rebase*)",
      "Read(~/.claude.json)"
    ],
    "defaultMode": "auto"
  },
  "model": "fable",
  "effortLevel": "xhigh",
  "env": {
    "HF_HUB_OFFLINE": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/paste-view"
  },
  "autoUpdatesChannel": "latest",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "bash ~/.claude/scripts/session-start.sh" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "context-mode hook claude-code pretooluse || true" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "rtk hook claude" }]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/destructive-guard.sh" },
          { "type": "command", "command": "bash ~/.claude/hooks/branch-guard.sh" },
          { "type": "command", "command": "bash ~/.claude/hooks/secret-guard.sh" },
          { "type": "command", "command": "node ~/.claude/hooks/protect-gates.js" }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "node ~/.claude/hooks/protect-gates.js" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "context-mode hook claude-code posttooluse || true" }]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash -c 'timeout 10 mempalace hook run --hook stop --harness claude-code || true'" },
          { "type": "command", "command": "bash -c 'nohup bash ~/.claude/scripts/session-stop.sh >/dev/null 2>&1 &'" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bash -c 'timeout 10 mempalace hook run --hook precompact --harness claude-code || true'" },
          { "type": "command", "command": "context-mode hook claude-code precompact" }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ponytail": {
      "source": { "source": "github", "repo": "DietrichGebert/ponytail" }
    },
    "caveman": {
      "source": { "source": "github", "repo": "JuliusBrussee/caveman" }
    },
    "hono": {
      "source": { "source": "github", "repo": "honojs/skills" }
    },
    "vibe-wise": {
      "source": { "source": "github", "repo": "nykooi1/vibe-wise" }
    }
  },
  "enabledPlugins": {
    "ponytail@ponytail": true,
    "caveman@caveman": true,
    "vibe-wise@vibe-wise": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "hono@hono": true
  },
  "statusLine": {
    "type": "command",
    "command": "bash -c 'exec bash ~/.claude/scripts/statusline.sh'"
  }
}
